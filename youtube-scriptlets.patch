diff --git a/Vibrium/rust/vibrium-adblock/src/scriptlets.rs b/Vibrium/rust/vibrium-adblock/src/scriptlets.rs
new file mode 100644
index 0000000..147e8fd
--- /dev/null
+++ b/Vibrium/rust/vibrium-adblock/src/scriptlets.rs
@@ -0,0 +1,172 @@
+//! A small engine that only knows scriptlet (`+js(...)`) rules.
+//!
+//! Scriptlets must run in the page before any of the page's own scripts, and
+//! that can only be done synchronously from inside the renderer process (see
+//! `c++/adblock/scriptlet_engine.h`). The full network engine lives in the
+//! browser process and holds hundreds of thousands of rules, which is far too
+//! heavy to load into every renderer. A scriptlet-only engine contains just the
+//! few thousand `+js(` rules, so it loads in milliseconds and uses a few MB.
+//!
+//! Trust: some scriptlets (`trusted-*`) can rewrite arbitrary page data, so a
+//! list may only use them if it is trusted. Lists whose file name starts with
+//! [`TRUSTED_LIST_PREFIX`] are the ones Vibrium downloads from uBlock Origin's
+//! own repository; every other list is parsed without trust and its
+//! `trusted-*` rules are ignored. Lists are not user-editable through the UI,
+//! and anyone who can write files into the filter directory already controls
+//! the browser's blocking.
+
+use std::path::Path;
+
+use adblock::engine::Engine;
+use adblock::lists::{FilterSet, ParseOptions, RuleTypes};
+use adblock::resources::{PermissionMask, Resource};
+
+use crate::engine::limits;
+use crate::error::VibriumAdblockError;
+
+/// List names starting with this are parsed with the "trusted" permission.
+pub const TRUSTED_LIST_PREFIX: &str = "ubo-";
+
+/// adblock-rust `PermissionMask` bit for "trusted" scriptlets.
+const TRUSTED_PERMISSION: u8 = 1;
+
+/// Largest filter list file that will be read, in bytes.
+const MAX_LIST_BYTES: u64 = 10 * 1024 * 1024;
+
+pub struct ScriptletEngine {
+    engine: Engine,
+    rules: usize,
+}
+
+impl ScriptletEngine {
+    /// Builds the engine from every `<name>.txt` list in `directory` plus an
+    /// optional `resources.json` in the same directory.
+    ///
+    /// Without a usable `resources.json` there are no scriptlets to inject, so
+    /// this fails: callers then simply skip scriptlet injection. Unreadable
+    /// lists are skipped individually.
+    pub fn from_directory(directory: &Path) -> Result<Self, VibriumAdblockError> {
+        let resources = read_resources(&directory.join("resources.json"))?;
+
+        let entries = std::fs::read_dir(directory).map_err(|error| {
+            VibriumAdblockError::FilterListError(format!(
+                "Cannot read filter-list directory: {error}"
+            ))
+        })?;
+
+        let mut names: Vec<String> = entries
+            .filter_map(Result::ok)
+            .filter(|entry| entry.path().extension().is_some_and(|ext| ext == "txt"))
+            .filter_map(|entry| {
+                entry
+                    .path()
+                    .file_stem()
+                    .and_then(|stem| stem.to_str().map(str::to_owned))
+            })
+            .filter(|name| !name.starts_with('.'))
+            .collect();
+        names.sort();
+
+        let mut filter_set = FilterSet::new(false);
+        let mut rules = 0usize;
+
+        for name in names {
+            let path = directory.join(format!("{name}.txt"));
+
+            let too_big = std::fs::metadata(&path)
+                .map(|meta| meta.len() > MAX_LIST_BYTES)
+                .unwrap_or(true);
+            if too_big {
+                continue;
+            }
+            let Ok(text) = std::fs::read_to_string(&path) else {
+                continue;
+            };
+
+            let scriptlet_rules: Vec<&str> = text
+                .lines()
+                .map(str::trim)
+                .filter(|line| !line.starts_with('!') && line.contains("+js("))
+                .collect();
+            if scriptlet_rules.is_empty() {
+                continue;
+            }
+            rules += scriptlet_rules.len();
+
+            let permissions = if name.starts_with(TRUSTED_LIST_PREFIX) {
+                PermissionMask::from_bits(TRUSTED_PERMISSION)
+            } else {
+                PermissionMask::default()
+            };
+
+            filter_set.add_filter_list(
+                scriptlet_rules.join("\n"),
+                ParseOptions {
+                    rule_types: RuleTypes::CosmeticOnly,
+                    permissions,
+                    ..ParseOptions::default()
+                },
+            );
+        }
+
+        if rules == 0 {
+            return Err(VibriumAdblockError::FilterListError(
+                "No scriptlet rules are available".into(),
+            ));
+        }
+
+        let mut engine = Engine::new_with_filter_set(filter_set);
+        engine.use_resources(resources);
+
+        Ok(Self { engine, rules })
+    }
+
+    /// Number of scriptlet rules loaded (diagnostics and tests).
+    pub fn rule_count(&self) -> usize {
+        self.rules
+    }
+
+    /// The JavaScript to run in the page at `url` before its own scripts, or an
+    /// empty string when no scriptlet rule applies. Only http(s) URLs qualify.
+    pub fn injected_script(&self, url: &str) -> Result<String, VibriumAdblockError> {
+        let parsed = url::Url::parse(url)
+            .map_err(|error| VibriumAdblockError::InvalidRequest(error.to_string()))?;
+
+        if !matches!(parsed.scheme(), "http" | "https") || parsed.host_str().is_none() {
+            return Err(VibriumAdblockError::InvalidRequest(
+                "Scriptlets require a valid HTTP or HTTPS URL".into(),
+            ));
+        }
+
+        let script = self
+            .engine
+            .url_cosmetic_resources(parsed.as_str())
+            .injected_script;
+
+        if script.len() > limits::MAX_SCRIPT_BYTES {
+            return Ok(String::new());
+        }
+        Ok(script)
+    }
+}
+
+fn read_resources(path: &Path) -> Result<Vec<Resource>, VibriumAdblockError> {
+    let too_big = std::fs::metadata(path)
+        .map(|meta| meta.len() as usize > limits::MAX_RESOURCES_BYTES)
+        .map_err(|error| {
+            VibriumAdblockError::InvalidConfiguration(format!("Cannot read resources.json: {error}"))
+        })?;
+    if too_big {
+        return Err(VibriumAdblockError::InvalidConfiguration(
+            "resources.json is too large".into(),
+        ));
+    }
+
+    let json = std::fs::read_to_string(path).map_err(|error| {
+        VibriumAdblockError::InvalidConfiguration(format!("Cannot read resources.json: {error}"))
+    })?;
+
+    serde_json::from_str(&json).map_err(|error| {
+        VibriumAdblockError::InvalidConfiguration(format!("Invalid resources.json: {error}"))
+    })
+}
diff --git a/Vibrium/rust/vibrium-adblock/tests/scriptlet_engine_tests.rs b/Vibrium/rust/vibrium-adblock/tests/scriptlet_engine_tests.rs
new file mode 100644
index 0000000..391c51e
--- /dev/null
+++ b/Vibrium/rust/vibrium-adblock/tests/scriptlet_engine_tests.rs
@@ -0,0 +1,168 @@
+//! Tests for the scriptlet-only engine used inside renderer processes.
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU32, Ordering};
+
+use vibrium_adblock::ScriptletEngine;
+
+static COUNTER: AtomicU32 = AtomicU32::new(0);
+
+/// A scratch directory that is removed when dropped.
+struct TempDir(PathBuf);
+
+impl TempDir {
+    fn new() -> Self {
+        let path = std::env::temp_dir().join(format!(
+            "vibrium-scriptlets-{}-{}",
+            std::process::id(),
+            COUNTER.fetch_add(1, Ordering::SeqCst)
+        ));
+        std::fs::create_dir_all(&path).unwrap();
+        Self(path)
+    }
+    fn path(&self) -> &Path { &self.0 }
+    fn write(&self, name: &str, contents: &str) {
+        std::fs::write(self.0.join(name), contents).unwrap();
+    }
+}
+
+impl Drop for TempDir {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+/// `plain.js` (needs `safe.fn`) and `trusty.js` (requires the trusted permission).
+const RESOURCES: &str = r#"[
+  {"name":"safe.fn","aliases":[],"kind":{"mime":"fn/javascript"},"content":"ZnVuY3Rpb24gc2FmZUhlbHBlcigpe3JldHVybiAxO30="},
+  {"name":"plain.js","aliases":["pl.js"],"kind":{"mime":"application/javascript"},
+    "content":"ZnVuY3Rpb24gcGxhaW4oYSl7IHNlbGYuX19wbGFpbiA9IGE7IH0=","dependencies":["safe.fn"]},
+  {"name":"trusty.js","aliases":[],"kind":{"mime":"application/javascript"},
+    "content":"ZnVuY3Rpb24gdHJ1c3R5KGEpeyBzZWxmLl9fdHJ1c3R5ID0gYTsgfQ==","permission":1}
+]"#;
+
+fn dir_with(lists: &[(&str, &str)]) -> TempDir {
+    let dir = TempDir::new();
+    dir.write("resources.json", RESOURCES);
+    for (name, text) in lists {
+        dir.write(name, text);
+    }
+    dir
+}
+
+fn script(engine: &ScriptletEngine, url: &str) -> String {
+    engine.injected_script(url).unwrap()
+}
+
+#[test]
+fn scriptlet_is_injected_for_matching_host_only() {
+    let dir = dir_with(&[("ubo-a.txt", "example.com##+js(plain, hello)\n")]);
+    let engine = ScriptletEngine::from_directory(dir.path()).unwrap();
+
+    let matched = script(&engine, "https://example.com/page");
+    assert!(matched.contains("plain(\"hello\")"), "{matched}");
+    // The dependency must be emitted too, or the scriptlet would throw.
+    assert!(matched.contains("function safeHelper"), "{matched}");
+
+    assert!(script(&engine, "https://other.org/").is_empty());
+}
+
+#[test]
+fn aliases_resolve() {
+    let dir = dir_with(&[("ubo-a.txt", "example.com##+js(pl, hi)\n")]);
+    let engine = ScriptletEngine::from_directory(dir.path()).unwrap();
+    assert!(script(&engine, "https://example.com/").contains("plain(\"hi\")"));
+}
+
+#[test]
+fn trusted_scriptlets_need_a_trusted_list() {
+    let rule = "example.com##+js(trusty, x)\n";
+
+    let trusted = dir_with(&[("ubo-a.txt", rule)]);
+    let engine = ScriptletEngine::from_directory(trusted.path()).unwrap();
+    assert!(script(&engine, "https://example.com/").contains("trusty(\"x\")"));
+
+    // Same rule from a list that is not trusted: it must not run.
+    let untrusted = dir_with(&[("easylist.txt", rule)]);
+    let engine = ScriptletEngine::from_directory(untrusted.path()).unwrap();
+    assert!(script(&engine, "https://example.com/").is_empty());
+}
+
+#[test]
+fn untrusted_lists_can_still_use_ordinary_scriptlets() {
+    let dir = dir_with(&[("hagezi.txt", "example.com##+js(plain, ok)\n")]);
+    let engine = ScriptletEngine::from_directory(dir.path()).unwrap();
+    assert!(script(&engine, "https://example.com/").contains("plain(\"ok\")"));
+}
+
+#[test]
+fn exception_rule_cancels_a_scriptlet() {
+    let dir = dir_with(&[(
+        "ubo-a.txt",
+        "example.com,other.org##+js(plain, hello)\nexample.com#@#+js(plain, hello)\n",
+    )]);
+    let engine = ScriptletEngine::from_directory(dir.path()).unwrap();
+    assert!(script(&engine, "https://other.org/").contains("plain(\"hello\")"));
+    assert!(script(&engine, "https://example.com/").is_empty());
+}
+
+#[test]
+fn generic_scriptlet_rules_are_not_supported() {
+    // adblock-rust refuses `##+js(...)` without a hostname on purpose: a
+    // scriptlet that runs on every site is too risky.
+    let dir = dir_with(&[("ubo-a.txt", "##+js(plain, hello)\nexample.com##+js(plain, a)\n")]);
+    let engine = ScriptletEngine::from_directory(dir.path()).unwrap();
+    assert!(script(&engine, "https://other.org/").is_empty());
+}
+
+#[test]
+fn only_scriptlet_rules_are_loaded() {
+    let dir = dir_with(&[(
+        "ubo-a.txt",
+        "! comment\n||ads.example^\nexample.com##.banner\nexample.com##+js(plain, a)\n",
+    )]);
+    let engine = ScriptletEngine::from_directory(dir.path()).unwrap();
+    assert_eq!(engine.rule_count(), 1);
+}
+
+#[test]
+fn fails_without_resources() {
+    let dir = TempDir::new();
+    dir.write("ubo-a.txt", "example.com##+js(plain, a)\n");
+    assert!(ScriptletEngine::from_directory(dir.path()).is_err());
+}
+
+#[test]
+fn fails_without_scriptlet_rules() {
+    let dir = dir_with(&[("ubo-a.txt", "||ads.example^\n")]);
+    assert!(ScriptletEngine::from_directory(dir.path()).is_err());
+}
+
+#[test]
+fn malformed_resources_fail_cleanly() {
+    let dir = TempDir::new();
+    dir.write("resources.json", "{ not json");
+    dir.write("ubo-a.txt", "example.com##+js(plain, a)\n");
+    assert!(ScriptletEngine::from_directory(dir.path()).is_err());
+}
+
+#[test]
+fn only_http_urls_are_accepted() {
+    let dir = dir_with(&[("ubo-a.txt", "example.com##+js(plain, a)\n")]);
+    let engine = ScriptletEngine::from_directory(dir.path()).unwrap();
+    assert!(engine.injected_script("file:///etc/hosts").is_err());
+    assert!(engine.injected_script("about:blank").is_err());
+    assert!(engine.injected_script("not a url").is_err());
+}
+
+#[test]
+fn temp_files_and_non_txt_files_are_ignored() {
+    let dir = dir_with(&[
+        ("ubo-a.txt", "example.com##+js(plain, a)\n"),
+        (".ubo-b.txt", "example.org##+js(plain, b)\n"),
+        ("ubo-a.etag", "example.net##+js(plain, c)\n"),
+    ]);
+    let engine = ScriptletEngine::from_directory(dir.path()).unwrap();
+    assert!(script(&engine, "https://example.org/").is_empty());
+    assert!(script(&engine, "https://example.net/").is_empty());
+    assert!(!script(&engine, "https://example.com/").is_empty());
+}
