action("build_rust_adblock") {
  script = "//scripts/build_rust_adblock.py"

  inputs = [
    "//scripts/build_rust_adblock.py",
    "//rust/Cargo.toml",
    "//rust/Cargo.lock",
    "//rust/vibrium-adblock/Cargo.toml",
    "//rust/vibrium-adblock/build.rs",
    "//rust/vibrium-adblock/include/vibrium_adblock.h",
  ]

  outputs = [
    "$target_gen_dir/rust-adblock/vibrium_adblock.lib",
  ]

  args = [
    "--release",
    "--out-dir",
    rebase_path("$target_gen_dir/rust-adblock", root_build_dir),
  ]
}

config("rust_adblock_include") {
  include_dirs = [
    "//rust/vibrium-adblock/include",
  ]
}

config("rust_adblock_link") {
  lib_dirs = [ "$target_gen_dir/rust-adblock" ]

  libs = [
    "vibrium_adblock.lib",
    "ntdll.lib",
    "Ws2_32.lib",
    "Userenv.lib",
  ]
}

source_set("adblock_bridge") {
  sources = [
    "adblock_ffi.cc",
    "adblock_ffi.h",
    "adblock_service.cc",
    "adblock_service.h",
  ]

  public_configs = [
    ":rust_adblock_include",
    ":rust_adblock_link",
  ]

  deps = [
    ":build_rust_adblock",
    "//base",
  ]
}


